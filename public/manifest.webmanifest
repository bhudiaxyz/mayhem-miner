{
    "name": "Mayhem Miner",
    "short_name": "Mayhem Miner",
    "description": "Single-screen cavern platformer. Grab every crystal before the air runs out, then reach the portal.",
    "start_url": "./",
    "scope": "./",
    "display": "fullscreen",
